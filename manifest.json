{
  "manifest_version": 3,
  "name": "Web Link Previewer",
  "version": "1.0",
  "description": "Muestra una ventana flotante interactiva con la vista previa de cualquier enlace al pasar el ratón por encima.",
  "icons": {
    "48": "icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content_script.js"
      ],
      "css": [
        "style.css"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "web-link-previewer@custom-addon",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}

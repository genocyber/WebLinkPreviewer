{
  "manifest_version": 3,
  "name": "Web Link Previewer",
  "version": "1.2",
  "description": "Muestra una ventana flotante con la vista previa de cualquier enlace.",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "48": "icon.png"
  },
  "action": {
    "default_icon": "icon.png",
    "default_title": "Ajustes de Preview"
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content_script.js"
      ],
      "css": [
        "style.css"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "web-link-previewer@custom-addon",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}